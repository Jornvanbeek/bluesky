

#00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS SCENARIONAME RUNS MAXNODES USECACHE startseed ENDTIME TITLE
#00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS AMANSMALL 16 16 True 0 07:00:00 one

# experiment 1: effect of uncertainty on eaman
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS20certain sc 12 1 16 True 0 07:00:00 eaman_zero_uncertainty
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS20nopopup sc 12 16 16 True 0 07:00:00 eaman_no_popup
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS20 sc 12 16 16 True 0 07:00:00 eaman_fcfs


#experiment 2: effect of horizon extension considering uncertainty
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS14 sc 12 16 16 True 0 07:00:00 standard_aman
# 00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS20 sc 12 16 16 True 0 07:00:00 eaman ## is run before
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS25 sc 12 16 16 True 0 07:00:00 eaman_fcfs_25

#experiment 3: evaluation of schedulers
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS delay20 sc 12 16 16 True 0 07:00:00 eaman_delay
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS BOL20 sc 12 16 16 True 0 07:00:00 eaman_BOL
#00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS FCFS20 sc 12 16 16 True 0 07:00:00 eaman_fcfs  ## is run before

#extended horizon, part of 3
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS delay25 sc 12 16 16 True 0 07:00:00 eaman_delay_25
00:00:01.00> ADDMULTIPLEMC MC_SCENARIOS BOL25 sc 12 16 16 True 0 07:00:00 eaman_BOL_25
