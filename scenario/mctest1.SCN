# Test VNAV mode
# Land in EHAM, runway 06

0:00:00.00>ECHO runscn
0:00:00.00>plugin LOS_COUNT
0:00:00.00>CRE KL204,A320,EHAM,RWY18L,,0,0
0:00:00.00>ORIG KL204 EHAM RWY18L
0:00:00.00>DEST KL204 EHBK RWY21
0:00:00.00>SPD KL204 250
0:00:00.00>ALT KL204 3000
0:00:00.00>ADDWPT KL204 NV
0:00:00.00>ADDWPT KL204 RR, FL50
0:00:00.00>ADDWPT KL204 EHN, 3000
0:00:00.00>ADDWPT KL204 ZL006, 1000,180
##0:00:00.00> ADDWPT KL204 ZL004, 500
0:00:00.00>ADDWPT KL204 ZL006, 1000,180
0:00:00.00>showpz

0:00:00.00>cdmethod on

0:00:00.00>creconfs con2 b748 kl204 180 1 120 100 120 250



# Switch VNAV on (LNAV is already on due to ADDWPT)
0:00:00.00>KL204 VNAV on

